# MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Leave empty to run with a temporary in-memory database (data is lost on restart).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food2go?retryWrites=true&w=majority

# Any long random string; used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

PORT=5000
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000
